# ============================================================================
# KYNEX — Academic Intelligence OS — environment template
#
# NOTE: The Freebuff platform blocks creating/committing literal `.env*`
# files from the tooling, so this template lives as `env.example`. When
# self-hosting, copy it to `.env` (git-ignored) and fill in real values.
# On Freebuff itself, backend secrets are managed through the platform's
# Keys/API-keys UI and read server-side via `process.env`.
# ============================================================================

# --- Convex ------------------------------------------------------------------
# (Conventionally provided by the platform / `npx convex dev`; listed for
#  self-hosting completeness.)
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# --- AI gateway (backend-only; server-side via process.env) ------------------
# The shared integration key the AI gateway client is created with.
# Without it, KYNEX degrades gracefully: the Professor reports
# CONFIGURATION_REQUIRED and every non-AI feature stays fully functional.
VLY_INTEGRATION_KEY=your_ai_gateway_key_here

# --- OTP email delivery (optional; backend-only) -----------------------------
# Dedicated transactional-email key for verification codes. Falls back to
# the shared gateway key above when absent.
FREEBUFF_OTP_API_KEY=your_otp_email_key_here
